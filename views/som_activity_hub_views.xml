<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════ Client action: Centro de Actividades ═══════════ -->
    <record id="action_som_activity_hub" model="ir.actions.client">
        <field name="name">Centro de Actividades</field>
        <field name="tag">theme_list_modern.activity_hub</field>
    </record>

    <!-- ═══════════ Catálogo de tipos (solo administradores) ═══════════ -->
    <record id="view_som_activity_kind_list" model="ir.ui.view">
        <field name="name">som.activity.kind.list</field>
        <field name="model">som.activity.kind</field>
        <field name="arch" type="xml">
            <list default_order="category, sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="category"/>
                <field name="name"/>
                <field name="key"/>
                <field name="res_model"/>
                <field name="summary_prefixes"/>
                <field name="shared"/>
                <field name="notice"/>
                <field name="resolved_domain" optional="hide"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_som_activity_kind_form" model="ir.ui.view">
        <field name="name">som.activity.kind.form</field>
        <field name="model">som.activity.kind</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reclassify_all" type="object" string="Reclasificar todas las actividades"
                            class="btn-secondary"
                            help="Vuelve a asignar el tipo SOM a TODAS las actividades (activas y archivadas) con el catálogo actual."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre visible"/></h1>
                    </div>
                    <group>
                        <group string="Reconocimiento">
                            <field name="key"/>
                            <field name="res_model" placeholder="sale.order (vacío = cualquier modelo)"/>
                            <field name="summary_prefixes" placeholder="Un prefijo por línea"/>
                            <field name="group_xmlids" placeholder="modulo.group_x, modulo.group_y"/>
                        </group>
                        <group string="Presentación">
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="icon" placeholder="fa-bell"/>
                            <field name="color" widget="color"/>
                            <field name="shared"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Texto corto que ve el usuario al configurar"/>
                    </group>
                    <group string="Cierre automático (cron horario)">
                        <group>
                            <field name="notice"/>
                            <field name="notice_days" invisible="not notice"/>
                        </group>
                        <group>
                            <field name="resolved_domain" placeholder="[('state','in',['done','cancel'])]"/>
                            <field name="resolved_label" placeholder="Texto que queda en la actividad archivada"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_som_activity_kind" model="ir.actions.act_window">
        <field name="name">Catálogo de actividades SOM</field>
        <field name="res_model">som.activity.kind</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- ═══════════ Menú raíz propio ═══════════ -->
    <menuitem id="menu_som_activity_root"
              name="Actividades"
              sequence="2"
              web_icon="theme_list_modern,static/description/icon_activity_hub.svg"
              action="action_som_activity_hub"/>
    <menuitem id="menu_som_activity_hub"
              name="Centro de Actividades"
              parent="menu_som_activity_root"
              sequence="10"
              action="action_som_activity_hub"/>
    <menuitem id="menu_som_activity_kind"
              name="Catálogo de tipos"
              parent="menu_som_activity_root"
              sequence="90"
              action="action_som_activity_kind"
              groups="base.group_system"/>

</odoo>
